# Add these in Vercel → Project → Settings → Environment Variables.
# NEVER add real values to frontend JavaScript or commit a real .env file.
GEMINI_KEY=
GEMINI_KEY2=
GEMINI_KEY3=

# Stable Gemini model. Override if your Google AI project uses another supported model.
GEMINI_MODEL=gemini-3.8-flash

# Optional comma-separated allowed browser origins. Same-origin requests are allowed by default.
# Example: https://lexis-ai-chatini.vercel.app,https://your-custom-domain.example
ALLOWED_ORIGINS=

# Optional controls
REALITY_MAX_BODY_BYTES=180000
REALITY_MAX_OUTPUT_TOKENS=2600
REALITY_TIMEOUT_MS=45000
REALITY_PER_KEY_TIMEOUT_MS=15000
REALITY_RATE_LIMIT_PER_MINUTE=24
